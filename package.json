{
  "name": "gd-toolkit",
  "version": "0.8.0",
  "description": "Gacha design laboratory for Windows",
  "main": "desktop/main.cjs",
  "type": "module",
  "author": "GD Toolkit",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "electron-builder --win nsis --x64 --publish never",
    "test:desktop": "electron tests/desktop.cjs",
    "test:update-live": "electron tests/live-update.cjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "productName": "GD Toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/longnguy3n/GD-Toolkit.git"
  },
  "build": {
    "appId": "com.longnguy3n.gdtoolkit",
    "productName": "GD Toolkit",
    "executableName": "GDToolkit",
    "directories": {
      "output": "releases"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "ui/**/*",
      "unity/**/*",
      "README.md",
      "THIRD_PARTY.md",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GD-Toolkit-Setup-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "longnguy3n",
        "repo": "GD-Toolkit",
        "releaseType": "release"
      }
    ]
  }
}
